{
  "version": 1,
  "general": {
    "layout": "dwindle",
    "maxTilesPerWorkspace": 8
  },
  "animations": {
    "workspaces": { "enabled": true, "style": "slide", "bezier": "easeOutQuint", "speed": 2 }
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "outline": false,
    "layout": {
      "left": [
        { "id": "core.menu" },
        { "id": "core.workspaces" },
        { "id": "pomodoro" }
      ],
      "center": [],
      "right": [
        { "id": "wh01s17.indicators" },
        { "id": "media" },
        { "id": "wh01s17.metronome" },
        {
          "id": "wh01s17.clock",
          "format": "ddd d MMM",
          "formatAlt": "HH:mm",
          "weekStartDay": "monday"
        },
        { "id": "wh01s17.audio" }
      ]
    }
  },
  "bindings": [
    { "keys": "SUPER + SPACE", "command": "menu.open" },
    { "keys": "SUPER + ALT + SPACE", "command": "menu.apps" },
    { "keys": "SUPER + ESCAPE", "command": "menu.system" },
    { "keys": "SUPER + K", "command": "shortcuts.show" },
    { "keys": "SUPER + RETURN", "command": "terminal.open" },
    { "keys": "CTRL + ALT + A", "command": "audio.volume", "args": { "step": 1 } },
    { "keys": "CTRL + ALT + Z", "command": "audio.volume", "args": { "step": -1 } },
    { "keys": "CTRL + ALT + O", "command": "media.play-pause" },
    { "keys": "CTRL + ALT + P", "command": "media.next" },
    { "keys": "CTRL + ALT + I", "command": "media.previous" },
    { "keys": "SUPER + 1", "command": "workspace.focus", "args": { "id": 1 } },
    { "keys": "SUPER + 2", "command": "workspace.focus", "args": { "id": 2 } },
    { "keys": "SUPER + 3", "command": "workspace.focus", "args": { "id": 3 } },
    { "keys": "SUPER + 4", "command": "workspace.focus", "args": { "id": 4 } },
    { "keys": "SUPER + 5", "command": "workspace.focus", "args": { "id": 5 } },
    { "keys": "SUPER + 6", "command": "workspace.focus", "args": { "id": 6 } },
    { "keys": "SUPER + 7", "command": "workspace.focus", "args": { "id": 7 } },
    { "keys": "SUPER + 8", "command": "workspace.focus", "args": { "id": 8 } },
    { "keys": "SUPER + 9", "command": "workspace.focus", "args": { "id": 9 } },
    { "keys": "SUPER + 0", "command": "workspace.focus", "args": { "id": 10 } },
    { "keys": "SUPER + SHIFT + 1", "command": "tile.move", "args": { "id": 1 } },
    { "keys": "SUPER + SHIFT + 2", "command": "tile.move", "args": { "id": 2 } },
    { "keys": "SUPER + SHIFT + 3", "command": "tile.move", "args": { "id": 3 } },
    { "keys": "SUPER + SHIFT + 4", "command": "tile.move", "args": { "id": 4 } },
    { "keys": "SUPER + SHIFT + 5", "command": "tile.move", "args": { "id": 5 } },
    { "keys": "SUPER + SHIFT + 6", "command": "tile.move", "args": { "id": 6 } },
    { "keys": "SUPER + SHIFT + 7", "command": "tile.move", "args": { "id": 7 } },
    { "keys": "SUPER + SHIFT + 8", "command": "tile.move", "args": { "id": 8 } },
    { "keys": "SUPER + SHIFT + 9", "command": "tile.move", "args": { "id": 9 } },
    { "keys": "SUPER + SHIFT + 0", "command": "tile.move", "args": { "id": 10 } },
    { "keys": "SUPER + SHIFT + ALT + 1", "command": "tile.move", "args": { "id": 1, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 2", "command": "tile.move", "args": { "id": 2, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 3", "command": "tile.move", "args": { "id": 3, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 4", "command": "tile.move", "args": { "id": 4, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 5", "command": "tile.move", "args": { "id": 5, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 6", "command": "tile.move", "args": { "id": 6, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 7", "command": "tile.move", "args": { "id": 7, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 8", "command": "tile.move", "args": { "id": 8, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 9", "command": "tile.move", "args": { "id": 9, "follow": false } },
    { "keys": "SUPER + SHIFT + ALT + 0", "command": "tile.move", "args": { "id": 10, "follow": false } },
    { "keys": "SUPER + TAB", "command": "workspace.next" },
    { "keys": "SUPER + SHIFT + TAB", "command": "workspace.previous" },
    { "keys": "SUPER + LEFT", "command": "tile.focus", "args": { "direction": "left" } },
    { "keys": "SUPER + RIGHT", "command": "tile.focus", "args": { "direction": "right" } },
    { "keys": "SUPER + UP", "command": "tile.focus", "args": { "direction": "up" } },
    { "keys": "SUPER + DOWN", "command": "tile.focus", "args": { "direction": "down" } },
    { "keys": "SUPER + SHIFT + LEFT", "command": "tile.swap", "args": { "direction": "left" } },
    { "keys": "SUPER + SHIFT + RIGHT", "command": "tile.swap", "args": { "direction": "right" } },
    { "keys": "SUPER + SHIFT + UP", "command": "tile.swap", "args": { "direction": "up" } },
    { "keys": "SUPER + SHIFT + DOWN", "command": "tile.swap", "args": { "direction": "down" } },
    { "keys": "SUPER + MINUS", "command": "tile.resize", "args": { "dx": -20 } },
    { "keys": "SUPER + EQUAL", "command": "tile.resize", "args": { "dx": 20 } },
    { "keys": "SUPER + SHIFT + MINUS", "command": "tile.resize", "args": { "dy": -20 } },
    { "keys": "SUPER + SHIFT + EQUAL", "command": "tile.resize", "args": { "dy": 20 } },
    { "keys": "SUPER + W", "command": "tile.close" },
    { "keys": "SUPER + T", "command": "tile.float" },
    { "keys": "SUPER + J", "command": "tile.split" },
    { "keys": "SUPER + F", "command": "tile.fullscreen" },
    { "keys": "SUPER + L", "command": "workspace.layout" },
    { "keys": "SUPER + ALT + TAB", "command": "group.next" },
    { "keys": "SUPER + ALT + SHIFT + TAB", "command": "group.previous" },
    { "keys": "SUPER + CTRL + LEFT", "command": "group.previous" },
    { "keys": "SUPER + CTRL + RIGHT", "command": "group.next" },
    { "keys": "SUPER + S", "command": "scratchpad.toggle" },
    { "keys": "SUPER + ALT + S", "command": "scratchpad.move" },
    { "keys": "SUPER + G", "command": "group.toggle" },
    { "keys": "SUPER + ALT + G", "command": "group.move-out" },
    { "keys": "SUPER + ALT + LEFT", "command": "group.move-into", "args": { "direction": "left" } },
    { "keys": "SUPER + ALT + RIGHT", "command": "group.move-into", "args": { "direction": "right" } },
    { "keys": "SUPER + ALT + UP", "command": "group.move-into", "args": { "direction": "up" } },
    { "keys": "SUPER + ALT + DOWN", "command": "group.move-into", "args": { "direction": "down" } },
    { "gesture": "swipe-up", "command": "menu.open" },
    { "gesture": "two-finger-swipe-left", "command": "workspace.next" },
    { "gesture": "two-finger-swipe-right", "command": "workspace.previous" },
    { "gesture": "two-finger-swipe-down", "command": "scratchpad.toggle" }
  ],
  "keyboard": { "superAlternative": "ALT" },
  "apps": { "terminal": "com.termux" }
}
