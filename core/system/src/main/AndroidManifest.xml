<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Capa 2 de plan.md §5.9 (ocultar los botones en HyperOS). Sólo se obtiene con
        `adb shell pm grant`; sin él, el launcher sólo muestra el asistente de compatibilidad.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Estado de la red para el módulo de red de la barra (permiso normal; sin INTERNET, plan.md R9). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Visualizador del widget de TIDAL: `Visualizer` sobre la mezcla de salida. Android lo ata al
        permiso de micrófono aunque no se grabe nada; se pide sólo al tocar «visualizador» (R8).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!--
            Capa 3: gestos de borde. En su propio proceso para que el launcher note al instante si
            muere (NavigationWatchdog) y para que un fallo del launcher no deje sin navegación.
        -->
        <service
            android:name=".navigation.WhNavigationService"
            android:exported="true"
            android:label="@string/nav_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":nav">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wh_navigation_service" />
        </service>

        <!--
            Acceso a notificaciones (opt-in, plan.md R8): Android sólo deja leer las sesiones
            multimedia de otras apps (TIDAL, módulo `media`) y las notificaciones (insignias de los
            tiles, contador de la barra y panel) a quien lo tiene. Lo que lee no sale del proceso.
        -->
        <service
            android:name=".media.WhNotificationListener"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".navigation.NavigationLinkService"
            android:exported="false"
            android:process=":nav" />
    </application>
</manifest>
